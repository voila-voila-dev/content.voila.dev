{
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    // `@voila/rich-text-editor` (the admin's editor widget) ships its own TS
    // sources and imports them with explicit `.ts`/`.tsx` extensions. We never
    // emit, so allowing those paths costs nothing and keeps `typecheck` about
    // this app's code rather than a dependency's build style.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "~/*": ["./app/*"]
    }
  },
  "include": ["app", "scripts", "content.config.ts", "vite.config.ts", "worker-configuration.d.ts"]
}
