{
  "name": "@voila/vertigo.content.voila.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && wrangler deploy",
    "deploy:preview": "vite build && wrangler versions upload",
    "cf-typegen": "wrangler types",
    "migrate:generate": "voila migrate generate",
    "migrate:local": "voila migrate apply --target d1-local --db DB",
    "migrate:remote": "voila migrate apply --target d1-remote --db DB",
    "seed:local": "bun scripts/seed.ts --local",
    "seed:remote": "bun scripts/seed.ts --remote"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-start": "^1.0.0",
    "@voila/content": "workspace:*",
    "@voila/content-cli": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-react": "5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
