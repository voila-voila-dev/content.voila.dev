{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vertigo-content-voila-dev",
  // Custom server entry (app/server.ts) so the Cloudflare plugin and the
  // TanStack Start plugin resolve to the same module (Start auto-detects
  // `app/server.ts`).
  "main": "app/server.ts",
  "account_id": "3d9e9632be236005903c677f4e571f62",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // This site's OWN content database — the canonical, published Cinéma Vertigo
  // dataset. It is deliberately not the admin demo's D1: that database only ever
  // holds auth, because the demo gives each visitor a private Durable Object for
  // their content. Provision + fill it with:
  //
  //   wrangler d1 create vertigo-content-voila-dev   # paste the id below
  //   bun run migrate:remote                        # schema from content.config.ts
  //   bun run seed:remote                           # the canonical programme
  //
  // Local development needs none of that beyond `bun run migrate:local` +
  // `bun run seed:local`, which use wrangler's local D1 state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vertigo-content-voila-dev",
      "database_id": "ab65c3f3-7e14-4396-85a0-4e176915be00",
      "migrations_dir": "migrations"
    }
  ],

  // The demo's media bucket, so a poster uploaded through the admin resolves by
  // URL here. Nothing on this site ever writes to it.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "demo-content-voila-dev-media" }],

  // Serve the site at vertigo.content.voila.dev. A `custom_domain` route makes
  // wrangler provision the DNS record + certificate on deploy (the
  // content.voila.dev zone is on this account) — the same shape the admin demo
  // uses for demo.content.voila.dev.
  "routes": [{ "pattern": "vertigo.content.voila.dev", "custom_domain": true }]
}
