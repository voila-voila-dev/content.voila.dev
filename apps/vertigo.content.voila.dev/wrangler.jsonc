{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vertigo-content-voila-dev",
  // Custom server entry (app/server.ts) so the Cloudflare plugin and the
  // TanStack Start plugin resolve to the same module (Start auto-detects
  // `app/server.ts`).
  "main": "app/server.ts",
  "account_id": "3d9e9632be236005903c677f4e571f62",
  "compatibility_date": "2026-06-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // This site's OWN content database — the canonical, published Cinéma Vertigo
  // dataset. It is deliberately not the admin demo's D1: that database only ever
  // holds auth, because the demo gives each visitor a private Durable Object for
  // their content. Provision + fill it with:
  //
  //   wrangler d1 create vertigo-content-voila-dev   # paste the id below
  //   bun run migrate:remote                        # schema from content.config.ts
  //   bun run seed:remote                           # the canonical programme
  //
  // Local development needs none of that beyond `bun run migrate:local` +
  // `bun run seed:local`, which use wrangler's local D1 state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vertigo-content-voila-dev",
      "database_id": "ab65c3f3-7e14-4396-85a0-4e176915be00",
      "migrations_dir": "migrations"
    }
  ],

  // The media library. The admin half of this app (`/admin`) uploads posters and
  // stills here through the `_media` pipeline, and the public pages render the
  // resulting URLs. Its OWN bucket, not the demo's: this site writes to it, and
  // an editor here should never be able to touch the sandbox demo's assets.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "vertigo-content-voila-dev-media" }],

  // Non-secret runtime config for the admin's auth. The origin gives Secure
  // cookies + correct magic-link verify URLs; the from-address is used by the
  // Resend mailer (RESEND_API_KEY is a secret, not set here). Under `vite dev`
  // `app/lib/server.ts` passes `dev: true`, which drops the pinned origin so
  // magic links point at localhost instead of the live site.
  "vars": {
    "VOILA_BASE_URL": "https://vertigo.content.voila.dev",
    // The sending domain has to be one Resend has verified, which today is the
    // demo's subdomain; only the display name is this site's. Move it to a
    // vertigo subdomain once that domain is verified in Resend.
    "VOILA_AUTH_FROM": "Cinéma Vertigo <noreply@updates.demo.content.voila.dev>"
  },

  // Serve the site at vertigo.content.voila.dev. A `custom_domain` route makes
  // wrangler provision the DNS record + certificate on deploy (the
  // content.voila.dev zone is on this account) — the same shape the admin demo
  // uses for demo.content.voila.dev.
  "routes": [{ "pattern": "vertigo.content.voila.dev", "custom_domain": true }]

  // Secrets are NOT committed. `VOILA_AUTH_SECRET` signs sessions, CSRF tokens
  // and magic-link tokens; without it the Worker throws at boot:
  //   wrangler secret put VOILA_AUTH_SECRET
  //   wrangler secret put RESEND_API_KEY   (real magic-link email; else console)
}
